@page "/mating"
@attribute [Authorize]
@inject NavigationManager Navigation
@inject IndexedDbService Db

<PageTitle>Mating Records - iMbuzi Smart</PageTitle>

<div class="mating-list-page">
    <div class="page-header">
        <button class="back-btn" @onclick='() => Navigation.NavigateTo("/")'>&#8592; Back</button>
        <h2 class="page-title">Mating Records</h2>
        <button class="btn-icon-add" @onclick='() => Navigation.NavigateTo("/mating/new")' title="Record mating">&#43;</button>
    </div>

    <div class="list-toolbar">
        <div class="search-box">
            <span class="search-icon">&#128269;</span>
            <input type="search" class="search-input" placeholder="Search buck or doe&#8230;"
                @oninput="OnSearch" value="@_search" />
        </div>
        <select class="filter-select" @onchange="OnStatusFilter">
            <option value="">All records</option>
            <option value="pending">Pending kidding</option>
            <option value="kidded">Kidded</option>
            <option value="overdue">Overdue</option>
        </select>
    </div>

    @if (!_loaded)
    {
        <div class="list-loading">Loading&#8230;</div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="empty-notice">
            <span class="empty-notice-icon">&#129309;</span>
            @if (_records.Count == 0)
            {
                <p>No mating records yet.</p>
                <button class="btn-primary" @onclick='() => Navigation.NavigateTo("/mating/new")'>
                    &#43; Record Mating
                </button>
            }
            else
            {
                <p>No records match your filter.</p>
            }
        </div>
    }
    else
    {
        <div class="record-count">@_filtered.Count record@(_filtered.Count == 1 ? "" : "s")</div>

        <div class="record-list">
            @foreach (var rec in _filtered)
            {
                var buck   = _animalMap.GetValueOrDefault(rec.BuckId);
                var doe    = _animalMap.GetValueOrDefault(rec.DoeId);
                var isPast = rec.ExpectedKiddingDate < DateTime.Today;
                var isOverdue = isPast && !rec.ActualKiddingDate.HasValue;
                <div class="record-card @(isOverdue ? "card-overdue" : "")">
                    <div class="record-card-body">
                        <div class="record-card-row">
                            <span class="record-animal">
                                &#9792; @(doe is not null ? $"{doe.Name} ({doe.Tag})" : "Unknown doe")
                            </span>
                            <span class="record-date">@rec.MatingDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="record-meta-row">
                            <span class="meta-chip chip-teal">&#9794; @(buck is not null ? buck.Name : "Unknown buck")</span>
                            @if (rec.ActualKiddingDate.HasValue)
                            {
                                <span class="meta-chip chip-cleared">&#9989; Kidded @rec.ActualKiddingDate.Value.ToString("dd MMM yyyy")</span>
                            }
                            else if (!isPast)
                            {
                                <span class="meta-chip">&#128020; Expected @rec.ExpectedKiddingDate.ToString("dd MMM yyyy")</span>
                            }
                            else
                            {
                                <span class="meta-chip chip-warning">&#9888; Overdue since @rec.ExpectedKiddingDate.ToString("dd MMM yyyy")</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(rec.Notes))
                        {
                            <p class="record-notes">@rec.Notes</p>
                        }
                    </div>
                    <div class="record-actions">
                        <button class="edit-btn" @onclick="() => EditRecord(rec.Id)" title="Edit">&#9998;</button>
                        @if (_confirmDeleteId == rec.Id)
                        {
                            <span class="delete-confirm-label">Delete?</span>
                            <button class="cancel-btn" @onclick="CancelDelete">No</button>
                            <button class="confirm-delete-btn" @onclick="() => DeleteRecord(rec.Id)">Yes</button>
                        }
                        else
                        {
                            <button class="delete-btn" @onclick="() => _confirmDeleteId = rec.Id" title="Delete">&#128465;</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<MatingRecord> _records = new();
    private List<MatingRecord> _filtered = new();
    private List<Animal> _animals = new();
    private Dictionary<Guid, Animal> _animalMap = new();
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private Guid? _confirmDeleteId;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var animals = await Db.GetAllAsync<Animal>("animals");
            _animals    = animals.OrderBy(a => a.Name).ToList();
            _animalMap  = animals.ToDictionary(a => a.Id);
            _records    = (await Db.GetAllAsync<MatingRecord>("matingRecords"))
                            .OrderByDescending(r => r.MatingDate)
                            .ToList();
            ApplyFilter();
        }
        catch { }
        finally { _loaded = true; }
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void OnStatusFilter(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _search.Trim().ToLower();
        _filtered = _records.Where(r =>
        {
            var isPast    = r.ExpectedKiddingDate < DateTime.Today;
            var isOverdue = isPast && !r.ActualKiddingDate.HasValue;
            var isKidded  = r.ActualKiddingDate.HasValue;
            var isPending = !isPast && !isKidded;

            if (_statusFilter == "pending"  && !isPending)  return false;
            if (_statusFilter == "kidded"   && !isKidded)   return false;
            if (_statusFilter == "overdue"  && !isOverdue)  return false;

            if (string.IsNullOrEmpty(q)) return true;
            var buck = _animalMap.GetValueOrDefault(r.BuckId);
            var doe  = _animalMap.GetValueOrDefault(r.DoeId);
            return (buck?.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) == true)
                || (buck?.Tag?.Contains(q, StringComparison.OrdinalIgnoreCase) == true)
                || (doe?.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) == true)
                || (doe?.Tag?.Contains(q, StringComparison.OrdinalIgnoreCase) == true);
        }).ToList();
    }

    private void EditRecord(Guid id) =>
        Navigation.NavigateTo($"/mating/{id}/edit");

    private async Task DeleteRecord(Guid id)
    {
        await Db.DeleteAsync("matingRecords", id);
        _records.RemoveAll(r => r.Id == id);
        _confirmDeleteId = null;
        ApplyFilter();
    }

    private void CancelDelete() => _confirmDeleteId = null;
}
