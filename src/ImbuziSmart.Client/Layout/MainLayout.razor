@inherits LayoutComponentBase
@inject ThemeService Theme
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthService Auth
@inject NavigationManager Nav
@inject IndexedDbService Db
@implements IDisposable

<PwaUpdateBanner />
<div class="app-layout">
    <header class="app-header">
        <div class="header-content">
            <a href="/" class="header-logo-link">
                <img src="/images/logo-icon.png" alt="Home" class="app-logo-img"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='inline'" />
                <span class="app-logo-fallback" style="display:none">&#128016;</span>
                <div class="header-brand">
                    <h1 class="app-title">iMbuzi Smart</h1>
                    <span class="app-tagline">Measure &amp; Manage Livestock</span>
                </div>
            </a>
            <SyncIndicator />
            <NotificationBell />

            <!-- Profile avatar -->
            <div class="profile-menu">
                <button class="profile-avatar" @onclick="ToggleProfile" title="Profile">
                    @_initials
                </button>
                @if (_profileOpen)
                {
                    <div class="profile-backdrop" @onclick="CloseProfile"></div>
                    <div class="profile-dropdown">
                        <div class="profile-info">
                            <div class="profile-avatar-lg">@_initials</div>
                            <div class="profile-details">
                                <span class="profile-fullname">@_fullName</span>
                                <span class="profile-farmname">@_farmName</span>
                            </div>
                        </div>
                        <div class="profile-divider profile-mobile-nav-only"></div>
                        <a href="pending" class="profile-nav-item profile-mobile-nav-only" @onclick="CloseProfile">
                            <span>&#8593;</span> Pending Sync
                        </a>
                        <AuthorizeView Roles="Owner">
                            <a href="team" class="profile-nav-item profile-mobile-nav-only" @onclick="CloseProfile">
                                <span>&#128101;</span> Team
                            </a>
                        </AuthorizeView>
                        <div class="profile-divider"></div>
                        <button class="theme-toggle profile-theme-toggle" @onclick="ToggleTheme">
                            @(Theme.IsDark ? "☀️ Light Mode" : "🌙 Dark Mode")
                        </button>
                        <div class="profile-divider"></div>
                        <button class="profile-logout" @onclick="LogoutAsync">
                            <span>&#128682;</span> Logout
                        </button>
                    </div>
                }
            </div>
        </div>
    </header>

    <div class="app-body">
        <!-- Sidebar — tablet & desktop only -->
        <nav class="side-nav">
            <NavLink href="/" class="side-nav-item" Match="NavLinkMatch.All">
                <span class="side-nav-icon">&#127968;</span>
                <span class="side-nav-label">Home</span>
            </NavLink>
            <NavLink href="animals" class="side-nav-item">
                <span class="side-nav-icon">&#128016;</span>
                <span class="side-nav-label">Animals</span>
            </NavLink>
            <NavLink href="passport" class="side-nav-item">
                <span class="side-nav-icon">&#128203;</span>
                <span class="side-nav-label">Passport</span>
            </NavLink>
            <NavLink href="weight" class="side-nav-item">
                <span class="side-nav-icon">&#9878;&#xFE0F;</span>
                <span class="side-nav-label">Weight</span>
            </NavLink>
            <NavLink href="medical" class="side-nav-item">
                <span class="side-nav-icon">&#128138;</span>
                <span class="side-nav-label">Medical</span>
            </NavLink>
            <NavLink href="mating" class="side-nav-item">
                <span class="side-nav-icon">&#129309;</span>
                <span class="side-nav-label">Mating</span>
            </NavLink>
            @if (_heatTrackingEnabled)
            {
                <NavLink href="heat/new" class="side-nav-item">
                    <span class="side-nav-icon">&#128149;</span>
                    <span class="side-nav-label">Log Heat</span>
                </NavLink>
            }
            <NavLink href="cost/ledger" class="side-nav-item">
                <span class="side-nav-icon">&#128176;</span>
                <span class="side-nav-label">Ledger</span>
            </NavLink>
            <NavLink href="pending" class="side-nav-item">
                <span class="side-nav-icon">&#8593;</span>
                <span class="side-nav-label">Pending</span>
            </NavLink>

            <div class="side-nav-divider"></div>

            <AuthorizeView Roles="Owner">
                <NavLink href="team" class="side-nav-item">
                    <span class="side-nav-icon">&#128101;&#xFE0F;</span>
                    <span class="side-nav-label">Team</span>
                </NavLink>
            </AuthorizeView>
            <NavLink href="settings" class="side-nav-item">
                <span class="side-nav-icon">&#9881;</span>
                <span class="side-nav-label">Settings</span>
            </NavLink>
        </nav>

        <main class="app-main">
            @Body
        </main>
    </div>

    <!-- Bottom nav — mobile only -->
    <nav class="bottom-nav">
        <a href="/" class="nav-item">
            <span class="nav-icon">&#127968;</span>
            <span class="nav-label">Home</span>
        </a>
        <a href="animals" class="nav-item">
            <span class="nav-icon">&#128016;</span>
            <span class="nav-label">Animals</span>
        </a>
        <a href="passport" class="nav-item">
            <span class="nav-icon">&#128203;</span>
            <span class="nav-label">Passport</span>
        </a>
        <a href="cost/ledger" class="nav-item">
            <span class="nav-icon">&#128176;</span>
            <span class="nav-label">Ledger</span>
        </a>
        <a href="settings" class="nav-item">
            <span class="nav-icon">&#9881;</span>
            <span class="nav-label">Settings</span>
        </a>
    </nav>
</div>

@code {
    private bool   _profileOpen;
    private string _initials = "?";
    private string _fullName = "";
    private string _farmName = "";
    private bool   _heatTrackingEnabled = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Theme.OnChange += StateHasChanged;
            await Theme.InitAsync();
            await LoadProfileAsync();
            await LoadSettingsAsync();
            StateHasChanged();
        }
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var all = await Db.GetAllAsync<FarmSettings>("farmSettings");
            var s = all.FirstOrDefault();
            if (s is not null) _heatTrackingEnabled = s.EnableHeatTracking;
        }
        catch { }
    }

    private async Task LoadProfileAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user  = state.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var first  = user.FindFirst("first_name")?.Value ?? "";
            var last   = user.FindFirst("last_name")?.Value  ?? "";
            _fullName  = $"{first} {last}".Trim();
            _farmName  = user.FindFirst("tenant_name")?.Value ?? "";
            var fi     = first.Length > 0 ? first[0].ToString().ToUpper() : "";
            var li     = last.Length  > 0 ? last[0].ToString().ToUpper()  : "";
            _initials  = (fi + li).Length > 0 ? fi + li : "?";
        }
    }

    private void ToggleProfile() => _profileOpen = !_profileOpen;
    private void CloseProfile()  => _profileOpen = false;

    private async Task LogoutAsync()
    {
        _profileOpen = false;
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    private async Task ToggleTheme() => await Theme.ToggleAsync();

    public void Dispose() => Theme.OnChange -= StateHasChanged;
}
