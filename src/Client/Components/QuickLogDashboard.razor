@namespace ImbuziSmart.Client.Components
@using ImbuziSmart.Client.Services
@using ImbuziSmart.Shared.Entities

@inject NavigationManager Navigation
@inject IndexedDbService Db

<div class="quick-log-dashboard">
    <h2 class="dashboard-title">Quick Log</h2>

    <div class="dashboard-grid">
        <QuickLogButton
            Icon="🐐"
            Label="New Animal"
            Color="#2ecc71"
            OnClick="@(() => NavigateTo("animals/new"))" />

        <QuickLogButton
            Icon="💉"
            Label="Medical Log"
            Color="#e74c3c"
            OnClick="@(() => NavigateTo("medical/new"))" />

        <QuickLogButton
            Icon="⚖️"
            Label="Weigh Animal"
            Color="#3498db"
            OnClick="@(() => NavigateTo("weight/new"))" />

        <QuickLogButton
            Icon="🤝"
            Label="Record Mating"
            Color="#9b59b6"
            OnClick="@(() => NavigateTo("mating/new"))" />

        <QuickLogButton
            Icon="🔥"
            Label="Log Heat"
            Color="#e84393"
            OnClick="@(() => NavigateTo("heat/new"))" />

        <QuickLogButton
            Icon="💰"
            Label="Log Cost"
            Color="#f39c12"
            OnClick="@(() => NavigateTo("cost/new"))" />

        <QuickLogButton
            Icon="📋"
            Label="Digital Passport"
            Color="#1abc9c"
            OnClick="@(() => NavigateTo("passport"))" />
    </div>

    @if (_heatAlerts.Count > 0 && _settings.EnableHeatTracking)
    {
        <div class="alerts-section">
            <h3 class="alerts-title">🔥 Ready for Buck</h3>
            @foreach (var alert in _heatAlerts)
            {
                <div class="alert-card heat-alert">
                    <span class="alert-animal">Doe</span>
                    <span class="alert-detail">
                        @(alert.IsInHeatWindow ? "In heat now!" : $"Heat in {alert.DaysUntilHeat} days")
                    </span>
                </div>
            }
        </div>
    }

    @if (_kiddingWatchAlerts.Count > 0 && _settings.NotifyKiddingWatch)
    {
        <div class="alerts-section">
            <h3 class="alerts-title">⚠️ Kidding Watch</h3>
            @foreach (var alert in _kiddingWatchAlerts)
            {
                <div class="alert-card kidding-watch">
                    <span class="alert-animal">Doe</span>
                    <span class="alert-detail">
                        @(alert.IsOverdue ? "Overdue!" : $"{alert.DaysRemaining} days remaining")
                    </span>
                </div>
            }
        </div>
    }

    @if (_weaningAlerts.Count > 0 && _settings.NotifyWeaning)
    {
        <div class="alerts-section">
            <h3 class="alerts-title">🍼 Weaning Due</h3>
            @foreach (var alert in _weaningAlerts)
            {
                <div class="alert-card weaning-alert">
                    <span class="alert-animal">Kid</span>
                    <span class="alert-detail">Ready for weaning</span>
                </div>
            }
        </div>
    }

    @if (_withdrawalAlerts.Count > 0 && _settings.NotifyWithdrawalExpiry)
    {
        <div class="alerts-section">
            <h3 class="alerts-title">🚫 Active Withdrawal</h3>
            @foreach (var alert in _withdrawalAlerts)
            {
                <div class="alert-card withdrawal">
                    <span class="alert-animal">@alert.Medication</span>
                    <span class="alert-detail">@alert.DaysRemaining days left</span>
                </div>
            }
        </div>
    }

    <div class="connectivity-indicator @(_isOnline ? "online" : "offline")">
        @(_isOnline ? "🟢 Online" : "🔴 Offline — data saved locally")
    </div>
</div>

@code {
    private FarmSettings _settings = new();
    private List<GestationTimerService.GestationStatus> _kiddingWatchAlerts = new();
    private List<GestationTimerService.GestationStatus> _weaningAlerts = new();
    private List<WithdrawalPeriodService.ActiveWithdrawal> _withdrawalAlerts = new();
    private List<HeatCycleService.HeatPrediction> _heatAlerts = new();
    private bool _isOnline;

    [Inject] private GestationTimerService GestationTimer { get; set; } = default!;
    [Inject] private HeatCycleService HeatCycle { get; set; } = default!;
    [Inject] private WithdrawalPeriodService WithdrawalService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isOnline = await Db.IsOnlineAsync();
            await LoadAlertsAsync();
        }
        catch
        {
            // Graceful fallback if IndexedDB is not available yet
        }
    }

    private async Task LoadAlertsAsync()
    {
        var settingsList = await Db.GetAllAsync<FarmSettings>("farmSettings");
        _settings = settingsList.FirstOrDefault() ?? new FarmSettings();

        var matingRecords = await Db.GetAllAsync<MatingRecord>("matingRecords");
        var gestations = GestationTimer.GetActiveGestations(matingRecords);
        _kiddingWatchAlerts = gestations.Where(g => g.IsOnKiddingWatch || g.IsOverdue).ToList();
        _weaningAlerts = GestationTimer.GetWeaningAlerts(matingRecords).ToList();

        var medicalLogs = await Db.GetAllAsync<MedicalLog>("medicalLogs");
        _withdrawalAlerts = medicalLogs
            .Where(m => m.WithdrawalEndDate.HasValue && m.WithdrawalEndDate.Value > DateTime.UtcNow.Date)
            .Select(m => new WithdrawalPeriodService.ActiveWithdrawal(
                m.Id, m.Medication, m.TreatmentDate, m.WithdrawalEndDate!.Value,
                (m.WithdrawalEndDate!.Value - DateTime.UtcNow.Date).Days))
            .ToList();

        if (_settings.EnableHeatTracking)
        {
            var heatRecords = await Db.GetAllAsync<HeatRecord>("heatRecords");
            var animals = await Db.GetAllAsync<Animal>("animals");
            var doeIds = animals
                .Where(a => a.Sex == Shared.Enums.Sex.Female && a.Status == Shared.Enums.AnimalStatus.Active)
                .Select(a => a.Id);
            _heatAlerts = HeatCycle.GetUpcomingHeats(heatRecords, doeIds, _settings).ToList();
        }
    }

    private void NavigateTo(string path) => Navigation.NavigateTo(path);
}
