@inherits LayoutComponentBase

<FluentLayout>
    <FluentHeader Style="background-color: #1a1a2e; padding: 0.5rem 1rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.5rem;">🐐</span>
                <span style="font-size: 1.3rem; font-weight: 700; color: #e94560;">iMbuzi Smart</span>
            </div>
            <FluentAnchor Href="settings" Appearance="Appearance.Stealth" title="Settings">
                <FluentIcon Value="@(new Icons.Regular.Size24.Settings())" Color="Color.Neutral" />
            </FluentAnchor>
        </div>
    </FluentHeader>

    <FluentBodyContent Style="background-color: #16213e; min-height: 100vh;">
        <main style="padding-bottom: 80px;">
            @Body
        </main>
    </FluentBodyContent>

    <FluentFooter Style="background-color: #1a1a2e; position: fixed; bottom: 0; width: 100%; z-index: 100;">
        <nav class="bottom-nav">
            <FluentAnchor Href="" Appearance="Appearance.Stealth" class="nav-item">
                <FluentIcon Value="@(new Icons.Regular.Size24.Home())" Color="Color.Neutral" />
                <span>Home</span>
            </FluentAnchor>
            <FluentAnchor Href="animals" Appearance="Appearance.Stealth" class="nav-item">
                <FluentIcon Value="@(new Icons.Regular.Size24.AnimalDog())" Color="Color.Neutral" />
                <span>Herd</span>
            </FluentAnchor>
            <FluentAnchor Href="passport" Appearance="Appearance.Stealth" class="nav-item">
                <FluentIcon Value="@(new Icons.Regular.Size24.DocumentBulletList())" Color="Color.Neutral" />
                <span>Passport</span>
            </FluentAnchor>
            <FluentAnchor Href="settings" Appearance="Appearance.Stealth" class="nav-item">
                <FluentIcon Value="@(new Icons.Regular.Size24.Settings())" Color="Color.Neutral" />
                <span>Settings</span>
            </FluentAnchor>
        </nav>
    </FluentFooter>
</FluentLayout>
